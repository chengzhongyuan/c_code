{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-project",
            "type": "shell",
            "command": "C:/MinGW/bin/g++.exe",
            "args": [
                "test.c",
                "stack_queue.c",
                "-g",
                "-o",
                "test.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "编译主程序和模块，生成可调试的 .exe"
        },
        // ✅ 新增任务：自动运行 test.exe
        {
            "label": "run program", // ← 独立任务，不能嵌套在上面
            "type": "shell",
            "command": ".\\test.exe",
            "dependsOn": ["build-project"], // ← 依赖编译任务
            "dependsOrder": "sequence",
            "group": {
                "kind": "build", // ✅ 设置为默认构建任务
                "isDefault": true
            },
            "detail": "编译完成后自动运行 test.exe"
        }
        
    ]
}