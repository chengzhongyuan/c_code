{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译 C++",
      "type": "shell",
      "command": "C:/MinGW/bin/g++.exe",
      "args": [
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "使用 MinGW 编译 C++ 文件"
    }
  ]
}
